---
import { ClientRouter } from 'astro:transitions';
const characters = [
  { img: '/img/bincho/bincho.gif', name: 'びんちょうタン', desc: '山の中の古いい一軒家に住む少女。けげに一人で暮らしている。お米を炊くのが上手。', cv: '野中藍' },
  { img: '/img/bincho/kunugi.gif', name: 'クヌギたん', desc: '大きなお屋敷に住む少女。学校に行くとき以外は敷地から出ることが許されないくらい過保護に育てられている。', cv: '野川さくら' },
  { img: '/img/bincho/chikutan.gif', name: 'ちくたん', desc: '楽師のマダけじいちゃん。妹のちくりんと三人で暮らしている。そっかしい面もあるが、家族思いの優しい子。', cv: '門脇舞' },
  { img: '/img/bincho/chikurin.gif', name: 'ちくりん', desc: '仕事のとき以外はいつもちくタんについていく、ちくタんの妹。幼く、言葉はカタコト。', cv: '福岡美里' },
  { img: '/img/bincho/rentan.gif', name: 'れんたん', desc: '両親が神主・住職。そのためか霊感を持っている。', cv: '佐藤利奈' },
  { img: '/img/bincho/aroetan.gif', name: 'あろえ', desc: '泳ぐのが大好き。水分が少なくなると元気がなくなります。', cv: '齋藤桃子' },
];
const navs = [
  { label: '登場人物', img: 'chara', href: '/' },
  { label: '物　語', img: 'story', href: '/story' },
  { label: '特別記事', img: 'special', href: '/special' },
];
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/gif" href="/img/bincho/over.gif" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<ClientRouter />
		<title>binchoutan</title>
		<style>
			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			html {
				scrollbar-gutter: stable;
			}

			body {
				background: url('/img/bg_parts.png') repeat-y left top, url('/img/bg.png') repeat left top;
				color: #000;
				font-family: 'Hiragino Kaku Gothic Pro', 'MS PGothic', sans-serif;
			}

			/* ===== 白色内容区（原站 table） ===== */
			.page {
				max-width: 720px;
				margin: 0 auto;
				background: #fff;
				min-height: 100vh;
				display: flex;
				flex-direction: column;
			}

			/* ===== 顶部行：标题 + 导航 ===== */
			.top-row {
				display: flex;
				align-items: center;
				justify-content: flex-start;
				padding-left: 8px;
				height: 87px;
				background: #fff;
				border-bottom: 2px solid #FFB6C1;
			}

			.title-cell {
				flex: 0 0 auto;
			}

			.site-title {
				display: flex;
				align-items: center;
				height: 87px;
				font-family: 'Hiragino Maru Gothic ProN', 'Yu Gothic', 'Meiryo', 'MS PGothic', sans-serif;
				font-weight: bold;
				font-size: 34px;
				line-height: 1;
				white-space: nowrap;
			}

			.title-main {
				display: inline-block;
				letter-spacing: 1px;
				color: #00AEEF;
				background: linear-gradient(180deg, #7fd8ff 0%, #00AEEF 55%, #0079bf 100%);
				-webkit-background-clip: text;
				background-clip: text;
				-webkit-text-fill-color: transparent;
				filter: drop-shadow(0 2px 0 rgba(0, 0, 0, 0.12));
			}

			.title-tan {
				margin-left: 4px;
				padding: 2px 6px;
				font-size: 0.9em;
				color: #E60012;
				border: 2px solid #E60012;
				border-radius: 3px;
				transform: rotate(-6deg);
				box-shadow: 0 2px 0 rgba(230, 0, 18, 0.18);
			}

			.nav-cell {
				flex: 0 0 auto;
				display: flex;
				align-items: center;
				white-space: nowrap;
			}

			.nav-cell a {
				position: relative;
				display: block;
				width: 74px;
				height: 87px;
				overflow: hidden;
				text-decoration: none;
			}

			.nav-default {
				position: absolute;
				left: 0;
				top: 0;
				width: 74px;
				height: 87px;
				object-fit: contain;
			}

			.nav-pop {
				position: absolute;
				left: 0;
				top: 100%;
				width: 74px;
				height: 80px;
				transition: top 0.25s ease;
			}

			.nav-cell a:hover .nav-pop {
				top: 7px;
			}

			.nav-cell a.tapped .nav-pop {
				top: 7px;
			}

			/* ===== 内容行：主体 ===== */
			.content-row {
				display: flex;
				align-items: flex-start;
				flex: 1;
			}

			.main-cell {
				flex: 1;
				padding: 10px 16px 30px 16px;
				background: url('/img/bincho/suigin.jpg') right bottom no-repeat;
			}

			.section-title {
				display: block;
				margin-bottom: 16px;
			}

			/* ===== 角色列表 ===== */
			.chara-list {
				list-style: none;
				padding: 0;
			}

			.chara-item {
				display: flex;
				align-items: flex-start;
				gap: 20px;
				padding: 16px 0;
				border-bottom: 1px dashed #ccc;
			}

			.chara-item:last-child {
				border-bottom: none;
			}

			.chara-item.reverse {
				flex-direction: row-reverse;
			}

			.chara-img {
				flex: 0 0 150px;
			}

			.chara-img img {
				display: block;
				width: 150px;
				height: auto;
				border: none;
			}

			.chara-info {
				flex: 1;
				padding-top: 4px;
			}

			.chara-name {
				font-size: 16px;
				font-weight: bold;
				color: #000;
				margin-bottom: 6px;
			}

			.chara-desc {
				font-size: 13px;
				color: #000;
				line-height: 1.9;
			}

			.chara-cv {
				font-size: 12px;
				color: #000;
				margin-top: 4px;
			}

			/* ===== 响应式 ===== */
			@media only screen and (max-width: 640px) {
				.top-row {
					height: auto;
					padding: 0 8px;
					background: #fff;
					border-bottom: 2px solid #FFB6C1;
					flex-wrap: wrap;
					justify-content: center;
				}

				.title-cell {
					max-width: 100%;
				}

				.site-title {
					height: 52px;
					font-size: 22px;
				}

				.nav-cell {
					width: 100%;
					justify-content: center;
					gap: 10px;
					margin-top: 2px;
				}

				.nav-cell a {
					width: 84px;
					height: 64px;
				}

				.nav-cell a .nav-default {
					width: 84px;
					height: 32px;
					top: auto;
					bottom: 0;
					left: 0;
					object-fit: cover;
					object-position: bottom;
				}

				.nav-cell a .nav-pop {
					width: 84px;
					height: 64px;
					top: 100%;
					object-fit: cover;
					object-position: center bottom;
				}

				.nav-cell a:hover .nav-pop,
				.nav-cell a:active .nav-pop,
				.nav-cell a.tapped .nav-pop {
					top: 0;
				}

				.content-row {
					flex-direction: column;
				}

				.main-cell {
					padding: 16px;
					text-align: center;
				}

				.section-title {
					width: 100%;
					max-width: 320px;
					height: auto;
					margin: 0 auto 16px;
					display: block;
				}

				.chara-item {
					flex-direction: column !important;
					align-items: center;
					text-align: center;
					gap: 10px;
					padding: 20px 0;
				}

				.chara-img {
					flex: none;
				}

				.chara-img img {
					width: 140px;
				}

				.chara-info {
					flex: none;
					width: 100%;
				}

				.chara-name {
					font-size: 20px;
				}

				.chara-desc {
					font-size: 16px;
					line-height: 1.7;
				}

				.chara-cv {
					font-size: 15px;
				}
			}
		</style>
	</head>
	<body>
		<div class="page">
			<!-- 顶部行：标题 + 导航 -->
			<div class="top-row">
				<div class="title-cell">
					<span class="site-title"><span class="title-main">びんちょう</span><span class="title-tan">タン</span></span>
				</div>
				<div class="nav-cell" id="navCell">
					{
						navs.map((n) => (
							<a href={n.href}>
								<img class="nav-default" src="/img/bincho/nav.gif" alt={n.label} />
								<img class="nav-pop" src="/img/bincho/over.gif" alt="" />
							</a>
						))
					}
				</div>
			</div>

			<!-- 内容行：主体 -->
			<div class="content-row">
				<div class="main-cell">
					<img class="section-title" src="/img/bincho/menu_chara.gif" alt="登場人物" />

					<ul class="chara-list">
						{
							characters.map((c, i) => (
								<li class:list={['chara-item', i % 2 === 1 && 'reverse']}>
									<div class="chara-img">
										<img src={c.img} alt={c.name} />
									</div>
									<div class="chara-info">
										<div class="chara-name">{c.name}</div>
										<div class="chara-desc" set:html={c.desc} />
										{c.cv && <div class="chara-cv">（CV：{c.cv}）</div>}
									</div>
								</li>
							))
						}
					</ul>
				</div>
			</div>


		</div>

		<script is:inline>
			if (window.matchMedia('(pointer: coarse)').matches) {
				document.querySelectorAll('.nav-cell a').forEach((link) => {
					link.addEventListener('click', (e) => {
						e.preventDefault();
						link.classList.add('tapped');
						setTimeout(() => {
							window.location.href = link.getAttribute('href');
						}, 350);
					});
				});
			}
		</script>
	</body>
</html>